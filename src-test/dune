(include_subdirs unqualified)

(ocamllex ctl_lexer)

(menhir
 (modules ctl_parser))

(library
 (name caprice_test)
 (synopsis "Caprice Test Language Definition and Semantics")
 (modules (:standard \ main))
 (libraries
  ; internal
  lang
  parsing
  concolic
  lsp
  ; external
  cmdliner
  alcotest
 )
 (instrumentation (backend landmarks --auto))
)

(test
 (name main)
 (modules main)
 (libraries
  ; internal
  caprice_test
  ; external
  alcotest
 )
 (deps
  (source_tree ../test/)))

(rule
 (target (dir "_bisect"))
 (alias coverage)
 (deps ./main.exe (source_tree ../test))
 (action
  (setenv BISECT_FILE "_bisect/bisect"
  (setenv CTL_TESTDIR ../%{env:TD=test}
  (setenv CTL_FLAGS %{env:CTL_FLAGS=-q}
    (progn
    (run mkdir -p _bisect)
    (run sh -c "exec %{exe:main.exe} -e $CTL_FLAGS")))))))