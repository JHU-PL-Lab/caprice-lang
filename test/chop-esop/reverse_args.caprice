      (cond
        (λ (x1)
          (cond
           ((equal? x1 0)
            (let ((x2 (x0 0)))
              (cond
               ((equal? x2 10) 12)
               ((equal? x2 23) 34)
               )))
           ((equal? x1 1)
            (let ((x3 (x0 1)))
              (cond
               ((equal? x3 37) 56)
               ((equal? x3 41) 78)
               )))
           )))
       ))

i.e.
  fun x0 x1 ->
    if x1 = 0 then
      let x2 = x0 0 in
      if x2 = 10 then 12
      else if x2 = 23 then 34
      else assert false
    else
      let x3 = x0 1 in
      if x3 = 37 then 56
      else if x3 = 41 then 78
      else assert false
*)