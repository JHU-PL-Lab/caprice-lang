(* TEST
  include exhaust;
*)

(* Various combinations and uses of higher order functions. *)

(* Any deterministic fun can act nondeterministic *)
let _ : (int -> int) -> int ~> int =
  fun f -> f

let _ : (int -> int) ~> int ~> int =
  fun f -> f

(* This is deterministically returns the same function and is fine *)
let _ : (int ~> int) -> int ~> int =
  fun f -> f

let _ : (int -> int ~> int) -> int =
  fun f ->
    let g = f 0 in (* no problems *)
    0 (* but we cannot apply g because it would be nondet *)

let _ : (int -> int -> int) -> int =
  fun f ->
    f 0 0

let _ : (int -> int -> int) ~> int =
  fun f ->
    f 0 0

let _ : (int -> int -> int) ~> int ~> int ~> int =
  fun f a b ->
    f a b

let _ : (int -> bool -> int) ~> int ~> bool ~> int =
  fun f -> f

let _ : ((int ~> int) -> int) ~> (int ~> int) ~> int =
  fun f g ->
    let _ = assert (f g == f g) in
    f g

let _ : ((int ~> int) -> int) ~> (int -> int) ~> int =
  fun f -> f

let _ : ((int -> bool) -> int) -> (int -> bool) ~> int =
  fun f g ->
    f g

let _ : ((int ~> int) -> int) -> (int -> int) -> int =
  fun f -> f
