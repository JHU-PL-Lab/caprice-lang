(* TEST
  include exhaust;
*)

(*
  Here is how we assert that X.t is the returned t
*)
let F : (X : sig val t : type -> type end) -> sig
  val t : (a : type) -> singleton (X.t a)
end = fun X -> struct
  let t = X.t
end

let f (dep tf : type -> type) (type a) : singleton (tf a) =
  tf a

let f (dep tf : type -> type) (type a) (x : tf a) (y : tf a) (b : bool) : tf a =
  if b then x else y

(*
  Even though singleton checks for equality, let's check one more time
*)
let _ =
  let X = struct let t a = { a : a } end in
  let M = F X in
  let f (type a) (x : X.t a) : M.t a =
    x
  in
  f

(*
  This is saying that Y.t = X.t, and we check that it is still type -> type.
*)
let F : (X : sig val t : type -> type end) -> (Y : sig val t : (a : type) -> singleton (X.t a) end) -> sig
  val t : type -> type
end = fun X Y -> struct
  let t = Y.t
end

(*
  ..
*)
let _ =
  let X = struct let t a = `A of a end in
  let Y = X in
  let M = F X Y in
  let f (type a) (x : X.t a) (y : Y.t a) : { x : M.t a ; y : M.t a } =
    { x = x ; y = y }
  in
  f

let apply_alias (f : bool -> int) (b : bool) ~> unit =
  let ft = f true in
  if b then
    assert (f true == f b)
  else
    ()

let apply_singleton (f : singleton type -> int) (a : singleton type) (b : singleton type) ~> int =
  if f a == f b
  then 0
  else false

let same_genfun (f : (int ~> int) -> int) (g : int ~> int) (h : int ~> int) ~> int =
  if f g == f g
  then 0
  else true
