(* TEST
  include exhaust;
*)

let rec map
  : (type a) -> (type b) -> (a -> b) -> list a -> list b
  = fun a b f ls ->
  match ls with
  | [] -> []
  | hd :: tl -> f hd :: map a b f tl
  end

let test (f : (list int -> list bool) -> bool) ~> int =
  if f (map int bool (fun i -> i % 2 == 0)) == f (map int bool (fun i -> i % 2 == 0))
  then 0
  else false
