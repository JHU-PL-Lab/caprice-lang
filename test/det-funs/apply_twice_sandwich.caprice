(* TEST
  include exhaust;
*)

let pgm (f : (int -> int) -> int) : unit =
  (* put an entry into f *)
  let _ = f (fun y -> y * 0) in
  (* Now put the entry we care about *)
  let j = f (fun x -> x) in
  (* Put another entry into f *)
  let _ = f (fun z -> z + 1) in
  (* We should still get the same output as an ealier call *)
  let k = f (fun x -> x) in
  assert (j == k)
