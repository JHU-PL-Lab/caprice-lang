(* TEST
  include refute;
*)

let non_neg = { i : int | i >= 0 }

let rec split_list (type a) (ls : list a) (n : non_neg) : { first_n : list a ; remaining : list a } =
  ifzero n then
    { first_n = [] ; remaining = ls }
  else
    match ls with
    | [] -> { first_n = n ; remaining = [] } (* ERROR: first_n = [] *)
    | hd :: tl ->
      let r = split_list a tl (n - 1) in
      { first_n = hd :: r.first_n ; remaining = r.remaining }
    end

let rec list_length (type a) (ls : list a) : non_neg =
  match ls with
  | [] -> 0
  | _ :: tl -> 1 + list_length a tl
  end

let rec is_sorted (type a) (cmp : a -> a -> int) (ls : list a) : bool =
  match ls with
  | [] | _ :: [] -> true
  | x :: (y :: _ as tl) ->
    cmp x y <= 0 && is_sorted a cmp tl
  end

let icmp a b =
  if a < b then -1
  else if a == b then 0
  else 1

let sorted_list = { ls : list int | is_sorted int icmp ls }

let rec merge (p : sorted_list) (q : sorted_list) : sorted_list =
  match p, q with
  | [], x | x, [] -> x
  | x :: p_tl, y :: q_tl ->
    if icmp x y < 0
    then x :: merge p_tl q
    else y :: merge p q_tl
  end

let rec merge_sort (ls : sorted_list) : sorted_list =
  match ls with
  | [] | _ :: [] -> ls
  | _ ->
    let r = split_list int ls (list_length int ls / 2) in
    let sorted_left = merge_sort r.first_n in
    let sorted_right = merge_sort r.remaining in
    merge sorted_left sorted_right
  end
