(* TEST
  include refute;
*)

(*
  This is a version of the layout_bintree program with some invariants
  on the coordinates.
  These invariants are not inductive; they do not establish that the
  tree is laid out properly, only that the coordinates are appropriately
  positive.
*)

let tree a = mu t.
  | `Empty of unit
  | `Node of a * t * t

let nat = { n : int | n >= 0 }

(* Intermediate layout representation with possibly negative x coordinate. *)
let tmp_layout a = tree (a * int * nat)

(* Fully laid out, with all natural coordinates. Semantically a subtype of tmp_layout *)
let t_layout a = tree (a * nat * nat)

let rec translate_x (type a) (t : tmp_layout a) (d : int) : tmp_layout a =
  match t with
  | `Empty () -> t
  | `Node ((v, x, y), l, r) ->
    `Node ((v, x + d, y), translate_x a l d, translate_x a r d)
  end

let min (a : int) (b : int) : int =
  if a < b then a else b

let max (a : int) (b : int) : int =
  if a > b then a else b

let rec min_x (type a) (t : tmp_layout a) : int =
  match t with
  | `Empty () -> 0
  | `Node ((_, x, _), l, r) ->
    min x (min (min_x a l) (min_x a r))
  end

let rec list_map (type a b) (f : a -> b) (ls : list a) : list b =
  match ls with
  | [] -> []
  | hd :: tl -> f hd :: list_map a b f tl
  end

let rec merge_profiles (type a) (p1 : list a) (p2 : list a) : list a =
  match p1, p2 with
  | x1 :: tl1, _ :: tl2 ->
    x1 :: merge_profiles a tl1 tl2
  | [], _ -> p2
  | _, [] -> p1
  end

(* Distance between a left subtree's right contour
   and a right subtree's left contour. *)
let rec dist (lr : list int) (rl : list int) : nat =
  match lr, rl with
  | lrx :: ltl, rlx :: rtl ->
    max (lrx - rlx) (dist ltl rtl)
  | [], _ | _, [] -> 0
  end

(* Intermediate layout. The profiles contain signed x coordinates
  because the root is at (0, depth). *)
let rec layout (type a) (depth : nat) (t : tree a) : list int * tmp_layout a * list int =
  match t with
  | `Empty () ->
    ([], `Empty 0, []) (* ERROR: empty payload must be unit *)
  | `Node (v, l, r) ->
    match layout a (depth + 1) l with
    | ll, l', lr ->
      match layout a (depth + 1) r with
      | rl, r', rr ->
        let d = 1 + dist lr rl / 2 in
        let ll = list_map int int (fun x -> x - d) ll in
        let lr = list_map int int (fun x -> x - d) lr in
        let rl = list_map int int (fun x -> x + d) rl in
        let rr = list_map int int (fun x -> x + d) rr in
        let t' = `Node ((v, 0, depth), translate_x a l' (1-d), translate_x a r' d) in
        (0 :: merge_profiles int ll rl,
         t',
         0 :: merge_profiles int rr lr)
      end
    end
  end

let rec list_min (l : list int) : { i : int | i <= 0 } =
  match l with
  | [] -> 0
  | hd :: tl ->
    let m = list_min tl in
    if hd < m then hd else m
  end

(* Shift right so that the x coordinate is positive *)
let finalize (type a) (dep t : tmp_layout a) (h : int | h + min_x a t >= 0) : t_layout a =
  translate_x a t h

(* Final layout. *)
let layout_binary_tree_3 (type a) (t : tree a) : t_layout a =
  match layout a 1 t with
  | l, t', _ ->
    let x_min = list_min l in
    finalize a t' (1 - x_min)
  end
