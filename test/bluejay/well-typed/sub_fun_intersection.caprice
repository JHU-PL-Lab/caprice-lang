(* subtyping of refined intersection type. *)

(* Encode intersection type *)
let t = { f : (x : `Int of int | `Bool of bool) ->
  match x with
  | `Int _ -> int
  | `Bool _ -> bool
  end
  | f (`Bool true)
}

let f =
  fun x ->
    match x with
    | `Bool b -> true
    | `Int i -> i
    | _ -> 1 :: 2 :: []
    end

let g (h : t) : t =
  fun x -> f x

let x = g f
